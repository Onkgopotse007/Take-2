# The game lives at https://take2.code-crunchers.com. Caddy gets and renews its certificate by
# itself (kept on the take2-caddy-data volume). DOMAIN can be overridden, e.g. DOMAIN=localhost
# to try the image on a laptop.
{$DOMAIN:take2.code-crunchers.com} {
	encode zstd gzip

	# Game server: matchmaking and WebSockets. The client always talks to /api.
	handle_path /api/* {
		reverse_proxy {$UPSTREAM:take2-server:2567}
	}

	# Hashed build files never change.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the app shell; table links like /K7MPX load it too.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Any other plain-HTTP request (the old http://140.238.81.209 links, or the domain without https)
# goes to the domain over HTTPS. Kubernetes' readiness probe lands here too and counts the
# redirect as healthy.
http:// {
	redir https://{$DOMAIN:take2.code-crunchers.com}{uri} permanent
}
