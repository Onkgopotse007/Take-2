# Take 2 lives at https://take2.code-crunchers.com and Madagascar at
# https://madagascar.code-crunchers.com. Both names serve the same app, which picks the game from
# the address. Caddy gets and renews a certificate for each by itself (kept on the
# take2-caddy-data volume). DOMAIN and MADAGASCAR_DOMAIN can be overridden, e.g. to localhost and
# madagascar.localhost to try the image on a laptop.
{$DOMAIN:take2.code-crunchers.com}, {$MADAGASCAR_DOMAIN:madagascar.code-crunchers.com} {
	encode zstd gzip

	# Game server: matchmaking and WebSockets. The client always talks to /api.
	handle_path /api/* {
		reverse_proxy {$UPSTREAM:take2-server:2567}
	}

	# Hashed build files never change.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the app shell; table links like /K7MPX load it too.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Plain HTTP. The games are only reachable by name: those are sent to HTTPS, and anything
# else (such as http://140.238.81.209) gets its connection closed. HTTPS by IP already fails,
# as there is no certificate for it. Certificate challenges are answered before these routes.
http:// {
	# Kubernetes' readiness probe, addressed to the pod's own IP (pods are 10.42.x.x on k3s).
	@probe expression {host}.startsWith("10.42.")
	@site host {$DOMAIN:take2.code-crunchers.com} {$MADAGASCAR_DOMAIN:madagascar.code-crunchers.com}

	# route keeps the order as written (Caddy would otherwise run abort before respond).
	route {
		respond @probe "ok" 200
		redir @site https://{host}{uri} permanent
		abort
	}
}
