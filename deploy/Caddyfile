# The game lives at https://take2.code-crunchers.com. Caddy gets and renews its certificate by
# itself (kept on the take2-caddy-data volume). DOMAIN can be overridden, e.g. DOMAIN=localhost
# to try the image on a laptop.
{$DOMAIN:take2.code-crunchers.com} {
	encode zstd gzip

	# Game server: matchmaking and WebSockets. The client always talks to /api.
	handle_path /api/* {
		reverse_proxy {$UPSTREAM:take2-server:2567}
	}

	# Hashed build files never change.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the app shell; table links like /K7MPX load it too.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Plain HTTP. The game is only reachable by its name: the domain is sent to HTTPS, and anything
# else (such as http://140.238.81.209) gets its connection closed. HTTPS by IP already fails,
# as there is no certificate for it. Certificate challenges are answered before these routes.
http:// {
	# Kubernetes' readiness probe, addressed to the pod's own IP (pods are 10.42.x.x on k3s).
	@probe header_regexp Host ^10\.42\.
	respond @probe "ok" 200

	@site host {$DOMAIN:take2.code-crunchers.com}
	redir @site https://{host}{uri} permanent

	abort
}
